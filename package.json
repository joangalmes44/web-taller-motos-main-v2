{
  "name": "ride-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22 <23", "npm": ">=10" },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p ${PORT:-3100}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p ${PORT:-3000} -H 0.0.0.0",
    "check-types-errors": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "source-map-js": "2.0.2"
  },
  "prettier": { "printWidth": 110, "singleQuote": true, "trailingComma": "all" }
}
