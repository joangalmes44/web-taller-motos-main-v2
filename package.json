{
  "name": "ride-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23", "npm": ">=10" },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p ${PORT:-3100}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p ${PORT:-3000} -H 0.0.0.0",
    "check-types-errors": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
  "@supabase/supabase-js": "^2.49.1",
  "next": "^15.2.0",
  "react": "^19.0.0",
  "react-dom": "^19.0.0",
  "zod": "^3.24.2"
  },
  "devDependencies": {
  "@eslint/js": "^9.21.0",
  "@tailwindcss/postcss": "^4.0.9",
  "@types/node": "^22.13.5",
  "@types/react": "^19.0.10",
  "@types/react-dom": "^19.0.4",
  "eslint": "^9.21.0",
  "prettier": "^3.5.2",
  "tailwindcss": "^4.0.9",
  "typescript": "^5.7.3"
  },
  "prettier": { "printWidth": 110, "singleQuote": true, "trailingComma": "all" }
}