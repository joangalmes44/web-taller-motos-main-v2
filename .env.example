# Variables que usa la app. La plataforma las completa sola al publicar; acá solo se documentan. No pongas claves reales en este archivo.
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Base: "dev" (pruebas) o "live" (web publicada)
TOTALUM_ENV=dev
TOTALUM_PROJECT_ID=
TOTALUM_PROJECT_KEY=
# Cuentas
BETTER_AUTH_SECRET=
# Dirección del dueño (administración)
TOTALUM_OWNER_EMAIL=joangll.jan@gmail.com
# Opcional: acceso con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: server-side service role key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH=false
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH_ENABLED=false
